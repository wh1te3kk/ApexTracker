<Window x:Class="ApexTracker.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Apex Tracker"
        Height="520"
        Width="920"
        MinHeight="480"
        MinWidth="760"
        Background="#111318"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Apex Tracker"
                       Foreground="#F4F7FB"
                       FontSize="34"
                       FontWeight="SemiBold" />
            <TextBlock Text="个人战绩记录客户端"
                       Margin="0,6,0,0"
                       Foreground="#9EA7B3"
                       FontSize="15" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="18"
                Background="#1B2028"
                BorderBrush="#2B3340"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding GameStatusText}"
                               Foreground="#F4F7FB"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding GameStatusDetail}"
                               Margin="0,6,0,0"
                               Foreground="#9EA7B3"
                               FontSize="14" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding LastUpdatedText}"
                           VerticalAlignment="Center"
                           Foreground="#9EA7B3"
                           FontSize="13" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="16"
                    Background="#181C23"
                    BorderBrush="#2B3340"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="总比赛"
                               Foreground="#9EA7B3"
                               FontSize="13" />
                    <TextBlock Text="{Binding TotalMatches}"
                               Margin="0,12,0,0"
                               Foreground="#F4F7FB"
                               FontSize="30"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="16"
                    Background="#181C23"
                    BorderBrush="#2B3340"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="今日比赛"
                               Foreground="#9EA7B3"
                               FontSize="13" />
                    <TextBlock Text="{Binding TodayMatches}"
                               Margin="0,12,0,0"
                               Foreground="#F4F7FB"
                               FontSize="30"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    Padding="16"
                    Background="#181C23"
                    BorderBrush="#2B3340"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="平均伤害"
                               Foreground="#9EA7B3"
                               FontSize="13" />
                    <TextBlock Text="{Binding AverageDamageText}"
                               Margin="0,12,0,0"
                               Foreground="#F4F7FB"
                               FontSize="30"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6"
                    Padding="16"
                    Background="#181C23"
                    BorderBrush="#2B3340"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="K/D"
                               Foreground="#9EA7B3"
                               FontSize="13" />
                    <TextBlock Text="{Binding KdText}"
                               Margin="0,12,0,0"
                               Foreground="#F4F7FB"
                               FontSize="30"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
